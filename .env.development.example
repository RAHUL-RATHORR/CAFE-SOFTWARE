# DineFlow — development environment example
# cp .env.development.example .env.development

APP_ENV=development
NODE_ENV=development

MONGODB_URI=mongodb://mongodb:27017/dineflow
MONGODB_DB_NAME=dineflow

NEXT_PUBLIC_APP_NAME=DineFlow
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=dev

AUTH_SECRET=dev-only-secret-change-me-32chars-min
AUTH_URL=http://localhost:3000
AUTH_DEMO_EMAIL=admin@dineflow.local
AUTH_DEMO_PASSWORD=Demo@12345
AUTH_DEMO_ROLE=manager

LOG_LEVEL=debug
RATE_LIMIT_ENABLED=false

APP_PORT=3000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
