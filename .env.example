# =============================================================================
# DineFlow — shared environment template
# Copy to .env.local (local Next.js) or use environment-specific examples.
# NEVER commit real secrets.
# =============================================================================

MONGODB_URI=mongodb://127.0.0.1:27017/dineflow
MONGODB_DB_NAME=dineflow
NEXT_PUBLIC_APP_NAME=DineFlow
NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_BUILD_ID=

# App environment: development | staging | production
# staging/production enforce AUTH_SECRET (32+) and MONGODB_URI via Zod.
APP_ENV=development

# Auth.js (NextAuth v5)
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
AUTH_URL=http://localhost:3000
AUTH_DEMO_EMAIL=admin@dineflow.local
AUTH_DEMO_PASSWORD=Demo@12345
AUTH_DEMO_ROLE=manager
# AUTH_DEMO_RESTAURANT_ID=

# Logging / ops
LOG_LEVEL=debug
RATE_LIMIT_ENABLED=false
# SLOW_OPERATION_MS=1000
# CACHE_TTL_SECONDS=60

# Docker Compose helpers
APP_PORT=3000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
IMAGE_TAG=latest
