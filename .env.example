# =============================================================================
# DineFlow — shared environment template
# Copy to .env.local (local Next.js) or use environment-specific examples.
# NEVER commit real secrets.
# =============================================================================

NODE_ENV=development
APP_ENV=development
PORT=3000

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
API_URL=http://localhost:3000/api

MONGODB_URI=mongodb://127.0.0.1:27017/dineflow
MONGODB_DB_NAME=dineflow

AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

CORS_ORIGINS=http://localhost:3000

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

SMS_PROVIDER=
SMS_API_KEY=

BACKUP_STORAGE_URL=
BACKUP_STORAGE_KEY=

LOG_LEVEL=debug
RATE_LIMIT_ENABLED=false
