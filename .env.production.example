# DineFlow — production environment example
# cp .env.production.example .env.production
# Inject secrets from a vault / host env / CI — never commit real values.

APP_ENV=production
NODE_ENV=production

# Prefer authenticated MongoDB in production
MONGODB_URI=mongodb://mongodb:27017/dineflow
MONGODB_DB_NAME=dineflow

NEXT_PUBLIC_APP_NAME=DineFlow
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=

# REQUIRED — replace before real deploy: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
AUTH_URL=https://app.example.com

# Disable demo auth credentials in real production
# AUTH_DEMO_EMAIL=
# AUTH_DEMO_PASSWORD=

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

APP_PORT=3000
MONGO_PORT=27017
IMAGE_TAG=latest

# Recommended for production Mongo
# MONGO_ROOT_USERNAME=dineflow
# MONGO_ROOT_PASSWORD=
# Then set MONGODB_URI=mongodb://dineflow:PASSWORD@mongodb:27017/dineflow?authSource=admin
