# DineFlow — staging environment example
# cp .env.staging.example .env.staging
# Fill secrets via your secret manager / CI variables — never commit real values.

APP_ENV=staging
NODE_ENV=production

MONGODB_URI=mongodb://mongodb:27017/dineflow
MONGODB_DB_NAME=dineflow

NEXT_PUBLIC_APP_NAME=DineFlow
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=staging

# REQUIRED — generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
AUTH_URL=https://staging.example.com

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

APP_PORT=3000
MONGO_PORT=27017
IMAGE_TAG=staging

# Optional Mongo auth (recommended for shared staging)
# MONGO_ROOT_USERNAME=
# MONGO_ROOT_PASSWORD=
